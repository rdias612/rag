# RAG System Configuration - Template
APP_ENV=dev

# Directories
DOCUMENTS_DIR=./documents

# Database
DB_HOST=localhost
DB_PORT=5433
DB_NAME=ragdb
DB_USER=postgres
DB_PASSWORD=changeme

# Models (Local via LM Studio)
LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1
EMBEDDING_MODEL=text-embedding-bge-m3
EMBEDDING_DIMENSION=1024
LLM_MODEL=phi-3.5-mini-instruct

# RAG Configuration
TOP_K_RESULTS=10
MIN_SIMILARITY_THRESHOLD=0.4
HYBRID_SEARCH_ALPHA=0.7

# Feature Flags
ENABLE_HYBRID_SEARCH=True
ENABLE_CONTEXT_COMPRESSION=True
ENABLE_RERANKING=True
ENABLE_QUERY_EXPANSION=True
ENABLE_MMR=True
ENABLE_HYDE=True
ENABLE_ADAPTIVE_RETRIEVAL=True
ENABLE_HIERARCHICAL_CHUNKING=False
ENABLE_AUTO_EVALUATION=False
ENABLE_SENTENCE_WINDOW=False

# NLP / Chunking
USE_SEMANTIC_CHUNKING=True
CHUNK_SIZE=800
CHUNK_OVERLAP=150
MIN_CHUNK_SIZE=200

# =========================================================================
# Encryption (Data at Rest) - Phase 5.4
# =========================================================================
# Enable/disable encryption of sensitive data
# WARNING: Once enabled, existing data won't be encrypted until re-ingested
ENABLE_ENCRYPTION=false

# Encryption key (generate with: python scripts/generate_encryption_key.py)
# IMPORTANT: Keep this key secret! Never commit to Git!
# ENCRYPTION_KEY=your-generated-key-here

# Specify which fields to encrypt (default: true)
ENCRYPT_DOCUMENT_CONTENT=true
ENCRYPT_METADATA=true
ENCRYPT_FEEDBACK_COMMENTS=true

# =========================================================================
# Security (Data in Transit) - Phase 5.4
# =========================================================================
# Enable HTTPS enforcement
ENABLE_HTTPS=false

# SSL/TLS Configuration (only needed if ENABLE_HTTPS=true)
# Generate self-signed certificate: openssl req -x509 -newkey rsa:4096 -keyout key.pem -out cert.pem -days 365 -nodes
SSL_CERT_PATH=./certs/cert.pem
SSL_KEY_PATH=./certs/key.pem
SSL_PROTOCOL=TLSv1.3
SSL_CIPHERS=HIGH:!aNULL:!MD5

# =========================================================================
# Advanced Features
# =========================================================================
# Connection Pooling
ENABLE_CONNECTION_POOL=true
DB_POOL_MIN_CONN=5
DB_POOL_MAX_CONN=20

# Advanced Batch Processing
ENABLE_ADVANCED_BATCH_PROCESSING=true
ADVANCED_BATCH_MAX_WORKERS=4
ADVANCED_BATCH_SIZE=32
