# RAG System Configuration - SIT Environment
APP_ENV=sit

# Directories
DOCUMENTS_DIR=/data/sit/documents

# Database
DB_HOST=sit-db-host
DB_PORT=5432
DB_NAME=ragdb_sit
DB_USER=sit_user
DB_PASSWORD=sit_password

# Models (Local via LM Studio)
LM_STUDIO_BASE_URL=http://lm-studio-sit:1234/v1
EMBEDDING_MODEL=text-embedding-bge-m3
EMBEDDING_DIMENSION=1024
LLM_MODEL=phi-3.5-mini-instruct

# RAG Configuration
TOP_K_RESULTS=10
MIN_SIMILARITY_THRESHOLD=0.4
HYBRID_SEARCH_ALPHA=0.7

# Feature Flags
ENABLE_HYBRID_SEARCH=True
ENABLE_CONTEXT_COMPRESSION=True
ENABLE_RERANKING=True
ENABLE_QUERY_EXPANSION=True
ENABLE_MMR=True
ENABLE_HYDE=True
ENABLE_ADAPTIVE_RETRIEVAL=True
ENABLE_HIERARCHICAL_CHUNKING=False
ENABLE_AUTO_EVALUATION=False
ENABLE_SENTENCE_WINDOW=False

# NLP / Chunking
USE_SEMANTIC_CHUNKING=True
CHUNK_SIZE=800
CHUNK_OVERLAP=150
MIN_CHUNK_SIZE=200
